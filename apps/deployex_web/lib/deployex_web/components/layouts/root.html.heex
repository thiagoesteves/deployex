<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <.live_title suffix=" · Monitoring Beam Apps">
      {assigns[:page_title] || "Deployex"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script>
      // Applies the theme and the sidebar state before the first paint. Both live on <html>, which
      // LiveView does not patch, so they survive live navigation.
      (() => {
        const html = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

        // data-theme holds the theme: the one the user picked, or the system's until they pick one
        const applyTheme = () => {
          html.dataset.theme = localStorage.getItem("phx:theme") || (systemDark.matches ? "dark" : "light");
        };

        const applySidebar = () => {
          if (localStorage.getItem("dx:sidebar") === "collapsed") {
            html.dataset.sidebar = "collapsed";
          } else {
            delete html.dataset.sidebar;
          }
        };

        // The ShellState hook in app.js mirrors these into the aria state of the shell controls
        const changed = () => window.dispatchEvent(new Event("dx:shell-state"));

        const saveTheme = (theme) => {
          localStorage.setItem("phx:theme", theme);
          applyTheme();
          changed();
        };

        applyTheme();
        applySidebar();

        window.addEventListener("dx:toggle-theme", () => {
          saveTheme(html.dataset.theme === "dark" ? "light" : "dark");
        });

        window.addEventListener("dx:toggle-sidebar", () => {
          if (html.dataset.sidebar === "collapsed") {
            localStorage.removeItem("dx:sidebar");
          } else {
            localStorage.setItem("dx:sidebar", "collapsed");
          }
          applySidebar();
          changed();
        });

        window.addEventListener("storage", (e) => {
          if (e.key === "phx:theme") applyTheme();
          if (e.key === "dx:sidebar") applySidebar();
          changed();
        });

        systemDark.addEventListener("change", () => {
          applyTheme();
          changed();
        });
      })();
    </script>
  </head>
  <body class="bg-base-200 antialiased">
    {@inner_content}
  </body>
</html>
